#include <iostream>
#include <queue>
#include <set>
#include <vector>
#include <string>
using namespace std;

struct State {
    int jug1, jug2;
    vector<string> path;
};

void waterJug(int capacity1, int capacity2, int target) {

    queue<State> q;
    set<pair<int, int>> visited;

    State start;
    start.jug1 = 0;
    start.jug2 = 0;
    start.path.push_back("Start: (0, 0)");

    q.push(start);
    visited.insert({0, 0});

    while (!q.empty()) {

        State current = q.front();
        q.pop();

        int a = current.jug1;
        int b = current.jug2;

        // Goal condition
        if (a == target || b == target) {

            cout << "\nSolution:\n";

            for (string step : current.path)
                cout << step << endl;

            return;
        }

        // 1. Fill Jug 1
        if (!visited.count({capacity1, b})) {
            State next = current;
            next.jug1 = capacity1;
            next.path.push_back("Fill Jug 1");
            q.push(next);
            visited.insert({capacity1, b});
        }

        // 2. Fill Jug 2
        if (!visited.count({a, capacity2})) {
            State next = current;
            next.jug2 = capacity2;
            next.path.push_back("Fill Jug 2");
            q.push(next);
            visited.insert({a, capacity2});
        }

        // 3. Empty Jug 1
        if (!visited.count({0, b})) {
            State next = current;
            next.jug1 = 0;
            next.path.push_back("Empty Jug 1");
            q.push(next);
            visited.insert({0, b});
        }

        // 4. Empty Jug 2
        if (!visited.count({a, 0})) {
            State next = current;
            next.jug2 = 0;
            next.path.push_back("Empty Jug 2");
            q.push(next);
            visited.insert({a, 0});
        }

        // 5. Pour Jug 1 into Jug 2
        int transfer = min(a, capacity2 - b);

        if (!visited.count({a - transfer, b + transfer})) {
            State next = current;
            next.jug1 = a - transfer;
            next.jug2 = b + transfer;
            next.path.push_back("Pour Jug 1 -> Jug 2");
            q.push(next);
            visited.insert({a - transfer, b + transfer});
        }

        // 6. Pour Jug 2 into Jug 1
        transfer = min(b, capacity1 - a);

        if (!visited.count({a + transfer, b - transfer})) {
            State next = current;
            next.jug1 = a + transfer;
            next.jug2 = b - transfer;
            next.path.push_back("Pour Jug 2 -> Jug 1");
            q.push(next);
            visited.insert({a + transfer, b - transfer});
        }
    }

    cout << "\nNo solution exists." << endl;
}

int main() {

    int jug1Capacity = 4;
    int jug2Capacity = 3;
    int target = 2;

    cout << "Water Jug Problem\n";
    cout << "Jug 1 Capacity = " << jug1Capacity << " litres\n";
    cout << "Jug 2 Capacity = " << jug2Capacity << " litres\n";
    cout << "Target = " << target << " litres\n";

    waterJug(jug1Capacity, jug2Capacity, target);

    return 0;
}
