#include <iostream>
#include <vector>
#include <queue>
using namespace std;

struct Node
{
    int vertex;
    int heuristic;
};

struct Compare
{
    bool operator()(Node a, Node b)
    {
        return a.heuristic > b.heuristic;
    }
};

int main()
{
    int n, edges;

    cout << "Enter number of vertices: ";
    cin >> n;

    vector<vector<int>> graph(n);
    vector<int> h(n);

    cout << "Enter heuristic values:\n";
    for (int i = 0; i < n; i++)
    {
        cout << "h(" << i << ") = ";
        cin >> h[i];
    }

    cout << "Enter number of edges: ";
    cin >> edges;

    cout << "Enter edges:\n";
    for (int i = 0; i < edges; i++)
    {
        int u, v;
        cin >> u >> v;

        graph[u].push_back(v);
        graph[v].push_back(u);
    }

    int start, goal;
    cout << "Enter starting vertex: ";
    cin >> start;

    cout << "Enter goal vertex: ";
    cin >> goal;

    priority_queue<Node, vector<Node>, Compare> pq;
    vector<bool> visited(n, false);

    pq.push({start, h[start]});

    cout << "Best First Search: ";

    while (!pq.empty())
    {
        Node current = pq.top();
        pq.pop();

        if (visited[current.vertex])
            continue;

        visited[current.vertex] = true;

        cout << current.vertex << " ";

        if (current.vertex == goal)
        {
            cout << "\nGoal reached!";
            break;
        }

        for (int neighbor : graph[current.vertex])
        {
            if (!visited[neighbor])
            {
                pq.push({neighbor, h[neighbor]});
            }
        }
    }

    return 0;
}
